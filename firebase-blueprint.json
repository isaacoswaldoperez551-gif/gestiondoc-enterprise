{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in GestiónDoc",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "department": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive", "locked"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "status"]
    },
    "Document": {
      "title": "Document",
      "description": "Document metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "fileType": { "type": "string", "enum": ["pdf", "docx", "xlsx", "other"] },
        "folderId": { "type": "string" },
        "folderName": { "type": "string" },
        "tagIds": { "type": "array" },
        "currentVersionId": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "fileType", "createdBy"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Document assignment to a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "documentId": { "type": "string" },
        "userId": { "type": "string" },
        "permissionLevel": { "type": "string", "enum": ["view", "download", "upload_version"] },
        "status": { "type": "string", "enum": ["pending", "in_progress", "submitted", "approved", "rejected"] },
        "dueDate": { "type": "string" },
        "assignedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "documentId", "userId", "permissionLevel", "status", "dueDate"]
    },
    "Folder": {
      "title": "Folder",
      "description": "Organizational folder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "parentId": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "createdBy"]
    },
    "Tag": {
      "title": "Tag",
      "description": "Document Tag",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" }
      },
      "required": ["id", "name", "color"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Notification message for user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of user profiles"
    },
    "/documents/{documentId}": {
      "schema": { "$ref": "#/entities/Document" },
      "description": "Collection of documents"
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Collection of document assignments"
    },
    "/folders/{folderId}": {
      "schema": { "$ref": "#/entities/Folder" },
      "description": "Collection of folders"
    },
    "/tags/{tagId}": {
      "schema": { "$ref": "#/entities/Tag" },
      "description": "Collection of tags"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Collection of notifications"
    }
  }
}
